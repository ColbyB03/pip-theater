{
  "name": "pip-theater",
  "version": "0.2.5",
  "description": "Picture-in-picture over your games: mirror your phone's screen (AirPlay) or play Netflix, YouTube and other streaming sites.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/package.mjs",
    "test": "python -m unittest discover -s tests"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "pip",
    "picture-in-picture",
    "airplay",
    "screen-mirroring"
  ],
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  }
}
